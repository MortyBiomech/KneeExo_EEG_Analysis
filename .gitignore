slprj/
codegen/

# Figure OUTPUT directory at the repository root (cfg.figures).
#
# The leading slash is load-bearing. An unanchored "figures/" matches a folder
# of that name at ANY depth, so it also excluded code/figures/, which holds the
# stage 7 and 8 entry points. Keep this anchored.
/figures/

# Local paths
code/config/local_paths.m


# Large data that must never enter the repository.
# Raw recordings, EEGLAB sets and multi-gigabyte intermediates live outside the
# repo; point kneeexo_config at them via cfg.raw.
*.xdf
*.set
*.fdt
*.icatimef
*.study


